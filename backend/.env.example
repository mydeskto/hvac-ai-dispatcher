# Port the Express API listens on (default 4000)
PORT=4000
# Comma-separated allowed origins for browsers calling the API directly.
# Leave unset in local dev; set to your frontend origin(s) in production.
# CORS_ORIGIN=https://app.example.com

# --- Telnyx (real inbound telephony for the AI voice agent) ---
# v2 API key from https://portal.telnyx.com
# TELNYX_API_KEY=KEY...
# Call Control application id the business number is assigned to
# TELNYX_CONNECTION_ID=1234567890
# The business number in E.164 format
# TELNYX_PHONE_NUMBER=+14155550142
# Public base URL of this API (use ngrok for local dev). Telnyx webhook:
#   ${PUBLIC_BASE_URL}/api/telnyx/webhook
# PUBLIC_BASE_URL=https://abc123.ngrok.io
